{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "summary": { "type": "string" },
    "approach": { "type": "string" },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "considerations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["schemaVersion", "summary", "approach", "steps", "considerations"]
}
