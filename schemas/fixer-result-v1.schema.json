{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "outcome": { "type": "string", "enum": ["changed", "no_change", "blocked"] },
    "summary": { "type": "string" },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "targetedTest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filePath": { "type": "string" },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" }
      },
      "required": ["filePath", "arguments", "rationale"]
    },
    "remainingRisk": { "type": "string" }
  },
  "required": [
    "schemaVersion", "outcome", "summary", "changedPaths",
    "targetedTest", "remainingRisk"
  ]
}
