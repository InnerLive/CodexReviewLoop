{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "summary": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "surface": {
            "type": "string",
            "enum": ["agents_md", "repository_skill"]
          },
          "scope": { "type": "string" },
          "lesson": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["title", "surface", "scope", "lesson", "evidence"]
      }
    }
  },
  "required": ["schemaVersion", "summary", "recommendations"]
}
