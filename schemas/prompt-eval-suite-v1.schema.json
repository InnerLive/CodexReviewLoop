{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "suite": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "caseId": { "type": "string" },
          "verdict": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "rationale": { "type": "string" }
        },
        "required": ["caseId", "verdict", "confidence", "rationale"]
      }
    }
  },
  "required": ["schemaVersion", "suite", "cases"]
}
