{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "3.0" },
    "accept": { "type": "boolean" },
    "summary": { "type": "string" },
    "feedback": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["schemaVersion", "accept", "summary", "feedback"]
}
