{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "accept": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "subject",
        "rationale",
        "changes"
      ]
    },
    "newOrders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "doneWhen": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "objective",
          "rationale",
          "doneWhen",
          "evidence"
        ]
      }
    },
    "workOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "withdrawn"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ]
      }
    },
    "goalComplete": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "accept",
    "summary",
    "feedback",
    "commitMessage",
    "newOrders",
    "workOutcomes",
    "goalComplete"
  ]
}
