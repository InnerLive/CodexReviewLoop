{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "decision": {
      "type": "string",
      "enum": ["approve", "revise", "reject_to_point_fix", "blocked"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "rationale": { "type": "string" },
    "coherentRootCause": { "type": "boolean" },
    "allFindingsCovered": { "type": "boolean" },
    "allRequiredPathsCovered": { "type": "boolean" },
    "minimalEnough": { "type": "boolean" },
    "missingPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredChanges": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "schemaVersion", "decision", "confidence", "rationale",
    "coherentRootCause", "allFindingsCovered", "allRequiredPathsCovered",
    "minimalEnough", "missingPaths", "requiredChanges"
  ]
}
