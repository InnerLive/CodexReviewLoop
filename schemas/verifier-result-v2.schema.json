{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "2.0" },
    "verdict": {
      "type": "string",
      "enum": ["reproduced", "resolved", "obsolete", "insufficient_evidence"]
    },
    "patchSafety": {
      "type": "string",
      "enum": ["safe", "regression_detected", "insufficient_evidence"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "rationale": { "type": "string" },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "invariant": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "required": ["title", "path", "line", "invariant", "rationale"]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "claim": { "type": "string" }
        },
        "required": ["path", "line", "claim"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "verdict",
    "patchSafety",
    "confidence",
    "rationale",
    "regressions",
    "evidence"
  ]
}
