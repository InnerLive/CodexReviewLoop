{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "verdict": {
      "type": "string",
      "enum": ["reproduced", "resolved", "obsolete", "insufficient_evidence"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "rationale": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "claim": { "type": "string" }
        },
        "required": ["path", "line", "claim"]
      }
    }
  },
  "required": [
    "schemaVersion", "verdict", "confidence", "rationale",
    "evidence"
  ]
}
