{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "verdict": {
      "type": "string",
      "enum": ["reproduced", "resolved", "obsolete", "insufficient_evidence"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "rationale": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "targetedTest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "passed": { "type": "boolean" },
        "evidence": { "type": "string" }
      },
      "required": ["command", "passed", "evidence"]
    }
  },
  "required": [
    "schemaVersion", "verdict", "confidence", "rationale",
    "evidence", "targetedTest"
  ]
}
